{
  "name": "ocean-game",
  "version": "1.6.3",
  "private": true,
  "description": "海战 OCEAN v1.6.3：黑潮军械库 UI 2.0、核心战斗训练与特效增强",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "start:lan": "node server/server.js --lan",
    "start:public": "node server/server.js --host 0.0.0.0",
    "dev": "node --watch server/server.js",
    "audio:build": "node scripts/build-audio-assets.js",
    "audio:validate": "node scripts/validate-audio-assets.js",
    "check": "node scripts/check-syntax.js",
    "check:v159": "node --check test/ocean-v1.5.9-responsive-layout.test.js",
    "check:v160": "node --check test/ocean-v1.6.0-cross-device.test.js",
    "check:v161": "node --check test/ocean-v1.6.1-tactical-layers.test.js",
    "test": "node --test",
    "acceptance": "npm run audio:validate && node scripts/acceptance-check.js && npm run check && npm run check:v159 && npm run check:v160 && npm run check:v161 && npm test",
    "build": "node scripts/build-ui.js",
    "prestart": "npm run build",
    "predev": "npm run build",
    "pretest": "npm run build",
    "prestart:lan": "npm run build",
    "prestart:public": "npm run build",
    "preacceptance": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "5.2.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "socket.io-client": "4.8.3"
  }
}
